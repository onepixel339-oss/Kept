# Kept — متغيرات البيئة
# انسخ هذا الملف كمرجع، لكن لا تضع قيمًا حقيقية هنا أبدًا.
# القيم الحقيقية تُضبط في Vercel ← Settings ← Environment Variables.
# الشرح الكامل خطوة بخطوة: DEPLOY-GUIDE.txt

# ── قاعدة البيانات (Supabase PostgreSQL) ─────────────────────────────
# اتصال التشغيل — Transaction Pooler (بورت 6543) — مناسب لسيرفرلس
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# اتصال الهجرات — Direct (بورت 5432) — يستخدمه prisma migrate فقط
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase API (Settings ← API) ────────────────────────────────────
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# مفتاح الخدمة (service key) — سري جدًا، يبقى على السيرفر فقط
SUPABASE_SECRET_KEY="sb_secret_..."

# ── أسرار التطبيق ────────────────────────────────────────────────────
# ولّده مرة واحدة: openssl rand -hex 32 — لا تغيره بعد أول نشر
KEPT_IDENTITY_SECRET=""

# ── اختياري ──────────────────────────────────────────────────────────
# اسم باكت التخزين (الافتراضي: kept-uploads — يُنشأ خاصًا تلقائيًا)
# KEPT_SUPABASE_BUCKET="kept-uploads"
# مزوّد الذكاء الاصطناعي (الافتراضي: zai)
# AI_PROVIDER="zai"
# محجوز لمهام مجدولة مستقبلية — لا يقرأه أي كود حاليًا
# CRON_SECRET=""
